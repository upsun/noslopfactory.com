---
// Static placeholder. The Foldkit header program replaces it when it starts.
import type { Section } from '../shop/cartView';

interface Props {
  section: Section;
}
const { section } = Astro.props;
const current = (value: Section) => (section === value ? 'page' : undefined);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="noslopfactory home">
    <span class="brand__mark" aria-hidden="true">
      n<span>/</span>
    </span>
    <span>
      noslopfactory<span class="brand__dot">.</span>
    </span>
  </a>
  <nav class="capsule-nav" aria-label="Main navigation">
    <a href="/" aria-current={current('Project')}>
      The project
    </a>
    <a href="/articles" aria-current={current('Articles')}>
      Articles
    </a>
    <a href="/shop" aria-current={current('Shop')}>
      The shop <span aria-hidden="true">↗</span>
    </a>
  </nav>
  <button
    class="cart-trigger"
    type="button"
    aria-haspopup="dialog"
    aria-label="Open cart, 0 items"
    disabled
  >
    <svg
      aria-hidden="true"
      width="18"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M5 7h14l1 14H4L5 7Z"></path>
      <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
    </svg>
    <span>Cart</span>
    <span class="cart-count">0</span>
  </button>
</header>
