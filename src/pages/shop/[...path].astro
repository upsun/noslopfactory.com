---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogData from '../../components/CatalogData.astro';
import Footer from '../../components/Footer.astro';

// Keep this list in sync with the routes in src/shop/route.ts.
export const getStaticPaths = (async () => {
  const products = await getCollection('products');
  return [
    { params: { path: undefined }, props: { title: 'The shop' } },
    ...['cart', 'checkout', 'confirmation'].map((path) => ({
      params: { path },
      props: {
        title:
          path === 'cart'
            ? 'Your cart'
            : path === 'checkout'
              ? 'Simulated checkout'
              : 'Demo confirmation',
      },
    })),
    ...products.map((product) => ({
      params: { path: `products/${product.id}` },
      props: { title: product.data.title },
    })),
  ];
}) satisfies GetStaticPaths;
const { title } = Astro.props;
---

<BaseLayout
  title={title}
  description="Shirts, caps, and stickers for the human in the loop. A demo shop with real skepticism and imaginary orders."
>
  <CatalogData />
  <div id="shop-root">
    <div class="shop-loading wrap">
      <span class="eyebrow">NOSLOPFACTORY / THE SHOP</span>
      <p>
        Gathering our thoughts<span aria-hidden="true">…</span>
      </p>
    </div>
  </div>
  <noscript>
    <main class="wrap empty-page" id="main">
      <h1>The shop needs JavaScript.</h1>
      <p>
        Enable JavaScript to browse products, manage your cart, and try the
        simulated checkout.
      </p>
      <a href="/">Back to the project</a>
    </main>
  </noscript>
  <Footer />
</BaseLayout>

<script>
  import '../../shop/entry';
</script>
