---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleTile from '../../components/ArticleTile.astro';
import { getArticles } from '../../lib/articleQueries';
import {
  formatArticleDate,
  readingMinutes,
  relatedArticles,
} from '../../lib/articles';

export const getStaticPaths = (async () => {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, related: relatedArticles(article, articles) },
  }));
}) satisfies GetStaticPaths;

const { article, related } = Astro.props;
const { title, description, publishedAt, category, mark, accent } =
  article.data;
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const minutes = readingMinutes(article.body ?? '');
const isoDate = publishedAt.toISOString().slice(0, 10);
---

<SiteLayout title={title} description={description} section="Articles">
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="article:published_time" content={isoDate} />
  </Fragment>
  <main class="article-page" id="main">
    <article>
      <header class="article-hero wrap">
        <div class="article-hero__tile">
          <a class="article-back" href="/articles">
            <span aria-hidden="true">←</span> All articles
          </a>
          <ArticleTile mark={mark} accent={accent} />
        </div>
        <div class="article-hero__text">
          <h1>{title}</h1>
          <p class="article-dek">{description}</p>
        </div>
        <dl class="article-meta">
          <div>
            <dt>Category</dt>
            <dd>{category}</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={isoDate}>{formatArticleDate(publishedAt)}</time>
            </dd>
          </div>
          <div>
            <dt>Reading time</dt>
            <dd>{minutes} min</dd>
          </div>
          <div class="article-meta__share" data-share hidden>
            <dt>Share</dt>
            <dd>
              <button type="button" data-copy-link>
                Copy link
              </button>
            </dd>
          </div>
        </dl>
      </header>
      <div class="article-body wrap">
        {sections.length > 1 && (
          <nav class="article-toc" aria-labelledby="article-toc-title">
            <p class="article-toc__title" id="article-toc-title">
              Contents
            </p>
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>
    {related.length > 0 && (
      <section class="article-related wrap" aria-labelledby="related-title">
        <div class="article-related__head">
          <h2 id="related-title">Keep reading.</h2>
          <a class="button" href="/articles">
            All articles <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="article-grid">
          {related.map((item) => (
            <ArticleCard article={item} />
          ))}
        </div>
      </section>
    )}
  </main>
</SiteLayout>

<script>
  // Copying needs the Clipboard API, so the share row stays hidden without it.
  const share = document.querySelector<HTMLElement>('[data-share]');
  const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  if (share && button && navigator.clipboard) {
    share.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        button.textContent = 'Link copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      window.setTimeout(() => {
        button.textContent = 'Copy link';
      }, 2000);
    });
  }
</script>
